{
  "manifest": {
    "abilities": [
      {
        "key": "Family",
        "scope": [
          "calendar"
        ],
        "token": "cap/calendar.read@1"
      },
      {
        "key": "family_reminders",
        "scope": [
          "list"
        ],
        "token": "cap/reminders.read@1"
      }
    ],
    "audience": {
      "id": "ag_synapse",
      "kind": "agent"
    },
    "destinations": [
      {
        "key": "planning",
        "kind": "room"
      },
      {
        "key": "me",
        "kind": "agent_inbox"
      },
      {
        "key": "alerts",
        "kind": "notice",
        "severity_max": "attention"
      }
    ],
    "explanation": "Read the selected calendar and reminder list and send a planning summary to the bound destinations.",
    "id": "family-planning",
    "purpose": "Plan family commitments",
    "trigger": {
      "schedule": {
        "interval": "1h"
      }
    },
    "version": 1
  },
  "reply": {
    "error": {
      "code": "install_refused",
      "message": "the manifest is invalid: abilities[0].key: must match [a-z][a-z0-9_]{0,39}"
    }
  }
}
