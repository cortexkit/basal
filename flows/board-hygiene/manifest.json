{
  "format": 1,
  "id": "board-hygiene",
  "version": 3,
  "purpose": "Nudge board owners and waited-on peers about ended waits, overdue ETAs, stale active items and completed lanes.",
  "trigger": {"schedule": {"cron": "*/5 * * * *", "tz": "UTC", "missed": "skip"}},
  "audience": {"kind": "global"},
  "ops": [{"module": "prefrontal-core", "op": "board.read"}],
  "board_read": ["$audience"],
  "facts": {"targets": ["$audience"]},
  "sinks": [{"agent": "$audience", "digest_max": "wake"}],
  "deadline": "4m"
}
