{
  "format": 1,
  "id": "ci-failure-router",
  "version": 4,
  "purpose": "Wake owners for actionable CortexKit CI failures, at most twice per run. Quiet (digest only, no wake): cortexkit/cerebellum, CI off by owner decision.",
  "trigger": {
    "events": [
      {"module": "plexus", "name": "github_ci_job_failed", "version": 2, "match": {"repo": "cortexkit/*"}},
      {"module": "plexus", "name": "github_ci_run_completed", "version": 2, "match": {"repo": "cortexkit/*"}}
    ]
  },
  "audience": {"kind": "global"},
  "sinks": [{"agent": "$audience", "digest_max": "wake"}],
  "ops": [{"module": "plexus", "op": "events_get"}],
  "deadline": "2m"
}
