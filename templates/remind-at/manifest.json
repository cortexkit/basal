{
  "format": 1,
  "id": "remind-at",
  "version": 3,
  "purpose": "Wake the creating agent once at a requested time, including one catch-up after downtime.",
  "trigger": { "schedule": { "at": "$params.at", "missed": "once" } },
  "sinks": [{ "agent": "$self", "digest_max": "wake" }, { "kind": "wait" }],
  "params": {
    "note": { "type": "string", "max_bytes": 4096 },
    "at": { "type": "timestamp", "max_ahead": "365d" }
  },
  "template": { "max_per_agent": 100, "max_lifetime": "365d" }
}
